{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "content-trees/tags",
    "version": "0.9.8",
    "title": "Content Trees: Tags",
    "category": "widgets",
    "icon": "tag",
    "description": "A compact list of tags and their published posts.",
    "keywords": ["tags", "tree", "navigation"],
    "textdomain": "content-trees",
    "attributes": {
        "title": { "type": "string" },
        "showPosts": { "type": "boolean", "default": true },
        "sortBy": { "type": "string", "enum": ["name", "count"], "default": "name" },
        "order": { "type": "string", "enum": ["ASC", "DESC"], "default": "ASC" },
        "postSortBy": { "type": "string", "enum": ["date", "modified", "title"], "default": "date" },
        "postOrder": { "type": "string", "enum": ["ASC", "DESC"], "default": "DESC" },
        "showCounts": { "type": "boolean", "default": true },
        "hideEmpty": { "type": "boolean", "default": true },
        "autoOpen": { "type": "boolean", "default": true },
        "showControls": { "type": "boolean", "default": false },
        "closeSiblings": { "type": "boolean", "default": false },
        "exclude": { "type": "array", "items": { "type": "integer" }, "default": [] },
        "excludePosts": { "type": "array", "items": { "type": "integer" }, "default": [] }
    },
    "supports": { "html": false, "customClassName": false },
    "editorScript": "content-trees-taxonomy-editor",
    "style": "content-trees",
    "viewScript": "content-trees-taxonomy"
}
