{
    "name": "ulfben/content-trees",
    "description": "Development checks for Content Trees",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
        "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check:encoding": "@php tests/check-encoding.php",
        "check:metadata": "@php tests/check-metadata.php",
        "check:bootstrap": "@php tests/check-test-bootstrap.php",
        "lint": "@php tests/lint.php",
        "phpcs": "@php vendor/bin/phpcs --runtime-set ignore_warnings_on_exit 1",
        "phpcbf": "@php vendor/bin/phpcbf",
        "test:integration": [
            "@php tests/integration/check-review-fixes.php",
            "@php tests/integration/check-pages.php",
            "@php tests/integration/check-taxonomy-loading.php",
            "@php tests/integration/check-taxonomy-selectors.php",
            "@php tests/integration/check-taxonomy-headings.php",
            "@php tests/integration/check-consolidation.php",
            "@php tests/integration/check-interface-text.php",
            "@php tests/integration/check-taxonomy-count-cache.php",
            "@php tests/integration/check-taxonomy-uninstall.php",
            "@php tests/check-taxonomy-uninstall-multisite.php"
        ]
    }
}
