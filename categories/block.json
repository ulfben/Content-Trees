{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "content-trees/categories",
    "version": "0.9.1",
    "title": "Content Trees: Categories",
    "category": "widgets",
    "icon": "category",
    "description": "A compact tree of categories and their published posts.",
    "keywords": ["categories", "tree", "navigation"],
    "textdomain": "content-trees",
    "attributes": {
        "title": { "type": "string", "default": "Categories" },
        "showPosts": { "type": "boolean", "default": true }
    },
    "supports": { "html": false, "customClassName": false },
    "editorScript": "content-trees-taxonomy-editor",
    "style": "content-trees"
}
